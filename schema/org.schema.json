{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "categories",
    "description",
    "location",
    "sources",
    "confidence",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug, equals the file name"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "name_he": {
      "type": "string",
      "description": "Hebrew name, if any"
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Former / alternative names"
    },
    "kind": {
      "enum": [
        "studio",
        "production_company",
        "startup",
        "agency",
        "client",
        "community"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "description_he": {
      "type": "string",
      "maxLength": 700,
      "description": "Hebrew translation of description"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 of the main / Israeli presence"
        },
        "city": {
          "type": "string"
        },
        "other_offices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "founded": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "size": {
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1001-5000",
        "5001+"
      ]
    },
    "status": {
      "enum": [
        "active",
        "acquired",
        "merged",
        "closed",
        "unknown"
      ],
      "default": "active"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "contact_url": {
      "type": "string",
      "format": "uri",
      "description": "Public contact page (no personal emails)"
    },
    "careers_url": {
      "type": "string",
      "format": "uri",
      "description": "Public jobs / careers page"
    },
    "reel_url": {
      "type": "string",
      "format": "uri",
      "description": "Showreel (Vimeo / YouTube / site)"
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      },
      "description": "linkedin, instagram, behance, vimeo, youtube, crunchbase, x, facebook..."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-text offerings / products"
    },
    "notable_clients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notable_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "role_type": {
            "enum": [
              "founder",
              "executive",
              "creative_lead",
              "production",
              "marketing",
              "other"
            ],
            "description": "production / marketing / creative_lead = people who commission creative work"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "as_of": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "Publicly listed founders / leadership only"
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string"
        },
        "total_usd_m": {
          "type": "number",
          "description": "Total raised, USD millions"
        },
        "investors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public": {
          "type": "boolean"
        },
        "ticker": {
          "type": "string"
        }
      }
    },
    "client_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "industry": {
          "type": "string"
        },
        "creative_needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_house_studio": {
          "type": "boolean"
        },
        "known_agencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "client",
              "agency",
              "parent",
              "subsidiary",
              "acquired",
              "acquired_by",
              "partner",
              "spun_off_from",
              "investor"
            ]
          },
          "target": {
            "type": "string",
            "description": "Org id if in the dataset, otherwise a plain name"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "high = confirmed by official site + 1 more source"
    },
    "added": {
      "type": "string",
      "format": "date"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  }
}
